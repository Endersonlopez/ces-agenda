{
  "expo": {
    "name": "Agenda CES",
    "slug": "agenda-ces",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#002C6C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.endersonlopez.agendaces"
    },
    "android": {
      "package": "com.endersonlopez.agendaces",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#002C6C"
      },
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#002C6C"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/logo.png"
    }
  }
}
